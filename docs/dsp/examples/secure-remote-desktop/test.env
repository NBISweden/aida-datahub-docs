# Default stack: Guacamole database authentication (no OIDC).

POSTGRES_DB=guacamole_db
POSTGRES_PASSWORD=guacamole_password
POSTGRES_PORT=5432
POSTGRES_USER=guacamole_user

# Guacamole web UI admin (database auth). Applied by guacamole-db-init.
GUACAMOLE_ADMIN_PASSWORD=guacadmin
GUACAMOLE_ADMIN_USERNAME=guacadmin

GUACAMOLE_HTTP_PORT=8081
GUACD_PORT=4822

# Keep OpenID off unless you configure an OIDC provider (see below).
EXTENSION_PRIORITY=*
OPENID_ENABLED=false

# Desktop image (any image with RDP on 3389 and SSH/SFTP on 2022 works).
REMOTE_DESKTOP_IMAGE=maiacloudai/ubuntu-rdp:1.0
REMOTE_DESKTOP_RDP_PORT=3389
REMOTE_DESKTOP_SSH_PORT=2022
REMOTE_DESKTOP_TZ=Etc/UTC

# ---------------------------------------------------------------------------
# Optional: OpenID Connect (any OIDC provider)
# ---------------------------------------------------------------------------
# 1. Create a confidential client in your IdP with redirect URI:
#      http://localhost:8081/remote-desktops/
# 2. Set the endpoints below from the IdP discovery document
#    (usually {issuer}/.well-known/openid-configuration).
# 3. Recreate Guacamole: docker compose up -d --force-recreate guacamole
# 4. Create a Guacamole user whose username matches OPENID_USERNAME_CLAIM_TYPE
#    (default: email claim), then link connections as usual.
#
# OPENID_ENABLED=true
# EXTENSION_PRIORITY=openid,*
# OPENID_AUTHORIZATION_ENDPOINT=https://idp.example.com/realms/myrealm/protocol/openid-connect/auth
# OPENID_JWKS_ENDPOINT=https://idp.example.com/realms/myrealm/protocol/openid-connect/certs
# OPENID_ISSUER=https://idp.example.com/realms/myrealm
# OPENID_CLIENT_ID=guacamole
# OPENID_CLIENT_SECRET=change-me
# OPENID_USERNAME_CLAIM_TYPE=email
# OPENID_REDIRECT_URI=http://localhost:8081/remote-desktops/
# OPENID_GROUPS_CLAIM_TYPE=groups

# ---------------------------------------------------------------------------
# Optional: local Keycloak (Compose profile "keycloak")
# ---------------------------------------------------------------------------
# Start with: docker compose --profile keycloak up -d
# Then enable OpenID above using the Keycloak endpoints, for example:
#
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_HTTP_PORT=8080
# OPENID_ENABLED=true
# EXTENSION_PRIORITY=openid,*
# OPENID_CLIENT_ID=srd
# OPENID_CLIENT_SECRET=a7941129f1f1818072258721
# OPENID_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/srd/protocol/openid-connect/auth
# OPENID_JWKS_ENDPOINT=http://keycloak:8080/realms/srd/protocol/openid-connect/certs
# OPENID_ISSUER=http://localhost:8080/realms/srd
# OPENID_REDIRECT_URI=http://localhost:8081/remote-desktops/
# OPENID_USERNAME_CLAIM_TYPE=email
# USER_EMAIL=admin@srd.dsp.se
# USER_PASSWORD=admin
