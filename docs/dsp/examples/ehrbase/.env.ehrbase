MANAGEMENT_ENDPOINT_HEALTH_ACCESS=read_only
MANAGEMENT_ENDPOINT_HEALTH_DATASOURCE_ACCESS=read_only
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=false
